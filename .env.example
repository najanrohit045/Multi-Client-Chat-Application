# Export these in the server terminal. This file is a template, not auto-loaded.
DB_URL=jdbc:mysql://localhost:3306/chat_app_v2?connectionTimeZone=UTC
DB_USERNAME=chat_user
DB_PASSWORD=replace_with_your_own_password
CHAT_HOST=127.0.0.1
CHAT_BIND=127.0.0.1
CHAT_PORT=9090
CHAT_MAX_CLIENTS=64
CHAT_FILES=server_files
# Clients only need CHAT_HOST and CHAT_PORT. Max attachment: 10 MiB.
